package blunderbuss

piece_value :[PieceType]int = {
	.Pawn = 100,
	.Knight = 300,
	.Bishop = 350,
	.Rook = 500,
	.Queen = 900,
	.King = MAX_SCORE
}

eval :: proc(position: ^Position) -> int {
	scores: [Colour]int
	us := position.turn

	for bbs, side in position.pieces {
		for bb, piece in bbs {
			bb := bb
			for bb > 0 {
				sq := pop_lsb(&bb)
				if side == .White {
					sq ~= 56
				}

				scores[side] += piece_value[piece] + piece_sq_tbl[piece][sq]
			}
		}
	}

	return scores[us] - scores[toggle(us)]
}

piece_sq_tbl: [PieceType][64]int = {
	.Pawn = pawn_tbl,
	.Knight = knight_tbl,
	.Bishop = bishop_tbl,
	.Rook = rook_tbl,
	.Queen = queen_tbl,
	.King = king_tbl,
}

